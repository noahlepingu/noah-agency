---
const lang = "$$LANG$$";
import '$$THEME_CSS_PATH$$';
import PageLayout from '@layouts/PageLayout.astro';
import ReservationForm from '@components/ReservationForm.astro';
import data from '$$DATA_PATH$$';
import uiStrings from '@translations/ui.json';
import { buildTitle, buildCanonical, buildHreflang } from '@utils/seo';

const ui = uiStrings[lang] || uiStrings.fr;
const texts = data.texts?.reservation || {};
const siteUrl = data.site_url || 'https://example.com';
const title = buildTitle({ title: texts.title || 'Reservation' }, data);
const canonical = buildCanonical(siteUrl, '/reservation');
const hreflang = buildHreflang(siteUrl, '/reservation');
---

<PageLayout lang={lang} title={title} description={title} canonical={canonical}
  hreflang={hreflang} ui={ui} data={data}
  heroTitle={texts.title}
  breadcrumb={[
    { label: ui.nav?.index || 'Accueil', href: '/' },
    { label: texts.title || 'Reservation', href: '/reservation' },
  ]}>
  <ReservationForm ui={ui} data={data.components?.reservation_form || {}} lang={lang} />
</PageLayout>