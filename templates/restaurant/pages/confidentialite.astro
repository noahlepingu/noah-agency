---
const lang = "$$LANG$$";
import '$$THEME_CSS_PATH$$';
import LegalLayout from '@layouts/LegalLayout.astro';
import data from '$$DATA_PATH$$';
import uiStrings from '@translations/ui.json';
import { buildCanonical } from '@utils/seo';
import { getPageTexts } from '@utils/i18n';

const ui = uiStrings[lang] || uiStrings.fr;
const texts = getPageTexts(data, lang, 'confidentialite');
const title = texts.title || 'Politique de confidentialite';
const canonical = buildCanonical(data.site_url || 'https://example.com', '/confidentialite');
---

<LegalLayout lang={lang} title={title} description={title} canonical={canonical}
  ui={ui} data={data}>
  <h1>{title}</h1>
  <p>{texts.content || ''}</p>
</LegalLayout>