---
const lang = "$$LANG$$";
import '$$THEME_CSS_PATH$$';
import LegalLayout from '@layouts/LegalLayout.astro';
import data from '$$DATA_PATH$$';
import uiStrings from '@translations/ui.json';
import { buildCanonical, buildDescription } from '@utils/seo';
import { getPageTexts, localizePath } from '@utils/i18n';

const ui = uiStrings[lang] || uiStrings.fr;
const title = getPageTexts(data, lang, 'plan_du_site').title || ui.footer?.sitemap || 'Plan du site';
const description = buildDescription({ description: data.seo_descriptions?.['/plan-du-site'] || data.seo?.meta_description || title || '' }, data);
const canonical = buildCanonical(data.site_url || 'https://example.com', '/plan-du-site');

// Pages du site depuis la config
const pages = data.site_pages || [
  { route: '/', label: 'Accueil' },
  { route: '/a-propos', label: 'A propos' },
  { route: '/menu', label: 'La Carte' },
  { route: '/reservation', label: 'Reservation' },
  { route: '/galerie', label: 'Galerie' },
  { route: '/temoignages', label: 'Avis' },
  { route: '/faq', label: 'FAQ' },
  { route: '/contact', label: 'Contact' },
  { route: '/mentions-legales', label: 'Mentions legales' },
  { route: '/confidentialite', label: 'Confidentialite' },
];
---

<LegalLayout lang={lang} title={title} description={description} canonical={canonical}
  ui={ui} data={data}>
  <h1>{title}</h1>
  <nav aria-label={ui.footer?.sitemap || 'Plan du site'}>
    <ul style="list-style: disc; padding-left: var(--space-6); line-height: 2;">
      {pages.map((p: any) => (
        <li><a href={localizePath(p.route, lang, data.translated_routes || [])}>{p.label}</a></li>
      ))}
    </ul>
  </nav>
</LegalLayout>