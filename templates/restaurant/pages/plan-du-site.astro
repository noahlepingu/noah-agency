---
const lang = "$$LANG$$";
import '$$THEME_CSS_PATH$$';
import LegalLayout from '@layouts/LegalLayout.astro';
import data from '$$DATA_PATH$$';
import uiStrings from '@translations/ui.json';
import { buildCanonical } from '@utils/seo';

const ui = uiStrings[lang] || uiStrings.fr;
const title = data.texts?.plan_du_site?.title || 'Plan du site';
const canonical = buildCanonical(data.site_url || 'https://example.com', '/plan-du-site');
const siteUrl = data.site_url || 'https://example.com';
const translatedRoutes = data.translated_routes || [];

// Ne prefixe /en que pour les routes dotees d'une version traduite
const localize = (route: string) => {
  if (lang !== 'en' || !translatedRoutes.includes(route)) return route;
  return route === '/' ? '/en/' : `/en${route}`;
};

// Pages du site depuis la config
const pages = data.site_pages || [
  { route: '/', label: 'Accueil' },
  { route: '/a-propos', label: 'A propos' },
  { route: '/menu', label: 'La Carte' },
  { route: '/reservation', label: 'Reservation' },
  { route: '/galerie', label: 'Galerie' },
  { route: '/temoignages', label: 'Avis' },
  { route: '/faq', label: 'FAQ' },
  { route: '/contact', label: 'Contact' },
  { route: '/mentions-legales', label: 'Mentions legales' },
  { route: '/confidentialite', label: 'Confidentialite' },
];
---

<LegalLayout lang={lang} title={title} description={title} canonical={canonical}
  ui={ui} data={data}>
  <h1>{title}</h1>
  <nav aria-label="Plan du site">
    <ul style="list-style: disc; padding-left: var(--space-6); line-height: 2;">
      {pages.map((p: any) => (
        <li><a href={localize(p.route)}>{p.label}</a></li>
      ))}
    </ul>
  </nav>
</LegalLayout>