---
const lang = "$$LANG$$";
import '$$THEME_CSS_PATH$$';
import PageLayout from '@layouts/PageLayout.astro';
import Menu from '@components/Menu.astro';
import data from '$$DATA_PATH$$';
import uiStrings from '@translations/ui.json';
import { buildTitle, buildDescription, buildCanonical, buildHreflang } from '@utils/seo';
import { getPageTexts } from '@utils/i18n';

const ui = uiStrings[lang] || uiStrings.fr;
const texts = getPageTexts(data, lang, 'menu');
const siteUrl = data.site_url || 'https://example.com';
const title = buildTitle({ title: data.seo_titles?.['/menu'] || texts.title || ui.nav?.menu || 'La Carte' }, data);
const description = buildDescription({ description: data.seo_descriptions?.['/menu'] || texts.subtitle || data.seo?.meta_description || '' }, data);
const canonical = buildCanonical(siteUrl, '/menu');
const hreflang = buildHreflang(siteUrl, '/menu');
---

<PageLayout lang={lang} title={title} description={description} canonical={canonical}
  hreflang={hreflang} ui={ui} data={data}
  heroTitle={texts.title || ui.nav?.menu || 'La Carte'}
  breadcrumb={[
    { label: ui.nav?.index || 'Accueil', href: '/' },
    { label: texts.title || ui.nav?.menu || 'La Carte', href: '/menu' },
  ]}>
  <Menu data={data.components?.menu || { categories: [], title: texts.title }} />
</PageLayout>