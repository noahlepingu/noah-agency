---
/**
 * ReservationForm.astro — Formulaire de reservation (restaurant)
 * Champs : date, heure, nombre de personnes, nom, email, telephone, message.
 * Etat "Aucun creneau" (UX.md §4.3) : jour ferme (horaire du jour absent ou
 * periode de fermeture) ou aucun creneau valide pour la date — plus de
 * simulateur : la logique est reelle et pure (utils/reservation.js).
 * Envoi : endpoint tiers si configure, sinon mailto (FORMS_ARCHITECTURE.md §3).
 * CNIL : mention d'information sous le formulaire.
 * Prop card=true : mode carte DA §5.7 (page 7/5), sans section ni en-tete.
 */
import Icon from './Icon.astro';

interface Props {
  ui: any;
  data: any; // data.components.reservation_form
  lang: 'fr' | 'en';
  card?: boolean;
}

const { ui, data, lang, card = false } = Astro.props;
const reserv = ui.reservation || {};
const maxGuests = data.max_party_size || 8;
const HONEYPOT = 'phone_confirm';

// Donnees et messages passes au script (i18n + creneaux statiques)
const uiJson = JSON.stringify({
  nameError: ui.form?.nameError || 'Veuillez renseigner votre nom.',
  emailError: ui.form?.emailError || 'Veuillez entrer un email valide.',
  phoneError: ui.form?.phoneError || 'Veuillez entrer un numero de telephone valide.',
  dateError: ui.form?.dateError || 'Veuillez choisir une date.',
  timeError: ui.form?.timeError || 'Veuillez choisir un creneau.',
  partySizeError: ui.form?.partySizeError || 'Veuillez indiquer le nombre de personnes.',
  globalError: ui.form?.globalError || '',
  loadError: ui.form?.loadError || "Erreur lors de l'envoi, veuillez reessayer.",
  sending: ui.form?.sending || 'Envoi...',
  submit: ui.form?.submit || 'Envoyer',
  noSlot: ui.states?.noSlot || { title: 'Aucun creneau disponible', message: '', cta1: 'Choisir une autre date', cta2: 'Nous appeler' },
  siteName: data.site_name || '',
  emailAddress: data.email || '',
  phone: data.phone || '',
});
const slotsJson = JSON.stringify(data.time_slots || []);
const scheduleJson = JSON.stringify(data.schedule || []);
const closedJson = JSON.stringify(data.closed_periods || []);
---

<section class:list={['ds-section', { 'ds-section--has-card': card }]}>
  <div class:list={[card ? 'ds-form-card' : 'ds-container ds-form']}>
    {!card ? (
      <div class="ds-section-head ds-section-head--centered">
        <h2 class="ds-section-head__title">{reserv.title || 'Reservez votre table'}</h2>
        {reserv.intro ? <p class="ds-section-head__subtitle">{reserv.intro}</p> : null}
      </div>
    ) : null}

    <form
      method="post"
      action={data.action || ''}
      data-form="reservation"
      data-json-form={uiJson}
      data-slots={slotsJson}
      data-schedule={scheduleJson}
      data-closed={closedJson}
      novalidate
    >
      <div class="ds-form__grid ds-form__grid--reservation">
        <div class="ds-form__field">
          <label for="r-date" class="ds-form__label">{ui.form.date} *</label>
          <input type="date" id="r-date" name="date" class="ds-form__input" required aria-required="true" aria-describedby="r-date-error" />
          <p class="ds-form__error" id="r-date-error" hidden></p>
        </div>

        <div class="ds-form__field">
          <label for="r-time" class="ds-form__label">{ui.form.time} *</label>
          <select id="r-time" name="time" class="ds-form__input ds-form__select" required aria-required="true" aria-describedby="r-time-error" data-time-select>
            <option value="">{ui.form.timeError}</option>
            {(data.time_slots || []).map((s: string) => <option value={s}>{s}</option>)}
          </select>
          <p class="ds-form__error" id="r-time-error" hidden></p>
        </div>

        <div class="ds-form__field">
          <label for="r-guests" class="ds-form__label">{ui.form.partySize} *</label>
          <select id="r-guests" name="guests" class="ds-form__input ds-form__select" required aria-required="true" aria-describedby="r-guests-error">
            {Array.from({ length: maxGuests }, (_, i) => i + 1).map((n) => (
              <option value={String(n)}>{n} {n === 1 ? (ui.reservation?.personOne || 'personne') : (ui.reservation?.personMany || 'personnes')}</option>
            ))}
          </select>
          <p class="ds-form__error" id="r-guests-error" hidden></p>
        </div>

        <div class="ds-form__field">
          <label for="r-name" class="ds-form__label">{ui.form.name} *</label>
          <input type="text" id="r-name" name="name" class="ds-form__input" required autocomplete="name" aria-required="true" aria-describedby="r-name-error" />
          <p class="ds-form__error" id="r-name-error" hidden></p>
        </div>

        <div class="ds-form__field">
          <label for="r-email" class="ds-form__label">{ui.form.email} *</label>
          <input type="email" id="r-email" name="email" class="ds-form__input" required autocomplete="email" aria-required="true" aria-describedby="r-email-error" />
          <p class="ds-form__error" id="r-email-error" hidden></p>
        </div>

        <div class="ds-form__field">
          <label for="r-phone" class="ds-form__label">{ui.form.phone}</label>
          <input type="tel" id="r-phone" name="phone" class="ds-form__input" autocomplete="tel" aria-describedby="r-phone-error" />
          <p class="ds-form__error" id="r-phone-error" hidden></p>
        </div>

        <div class="ds-form__field ds-form__field--full">
          <label for="r-message" class="ds-form__label">{ui.form.message}</label>
          <textarea id="r-message" name="message" class="ds-form__textarea" rows="3"></textarea>
        </div>

        <div class="ds-form__honeypot" aria-hidden="true">
          <label for={HONEYPOT}>{ui.form.honeypot}</label>
          <input type="text" id={HONEYPOT} name={HONEYPOT} tabindex="-1" autocomplete="off" />
        </div>
      </div>

      <p class="ds-form__note" id="form-reserv-note">{ui.form.privacyNote}</p>

      <p class="ds-form__global-error" role="alert" hidden data-form-error></p>

      <div class="ds-form__submit-row">
        <button type="submit" class="ds-btn ds-btn--primary" data-form-submit>
          <span data-form-submit-label>{ui.form.submit || 'Envoyer'}</span>
        </button>
      </div>

      <!-- Aucun creneau (UX.md §4.3) — role="status" (aria-live implicite polite)
           pour annoncer la bascule visible -> invisible aux lecteurs d'ecran.
           Le bloc est hidden au depart puis affiche par le JS (refreshSlots). -->
      <div class="ds-form__empty" hidden data-no-slot role="status" aria-live="polite">
        <Icon name="calendar" size={32} />
        <p class="ds-form__empty-title" data-no-slot-title>{ui.states?.noSlot?.title || 'Aucun creneau disponible'}</p>
        <p class="ds-form__empty-msg" data-no-slot-msg>{ui.states?.noSlot?.message || ''}</p>
        <div class="ds-form__empty-actions">
          <button type="button" class="ds-btn ds-btn--primary" data-retry-slot>{ui.states?.noSlot?.cta1 || 'Choisir une autre date'}</button>
          {data.phone ? (
            <a href={`tel:${data.phone}`} class="ds-btn ds-btn--outline">{ui.states?.noSlot?.cta2 || 'Nous appeler'}</a>
          ) : null}
        </div>
      </div>

      <!-- Confirmation -->
      <div class="ds-form__success" role="status" hidden data-form-success>
        <Icon name="check" size={32} />
        <p class="ds-form__success-title">{ui.states?.reservationOk?.title || 'Reservation confirmee !'}</p>
        <p class="ds-form__success-msg">{(ui.states?.reservationOk?.text || '').replace('{email}', data.email || '')}</p>
        <p class="ds-form__success-modify">{(ui.states?.reservationOk?.modify || '').replace('{phone}', data.phone || '')}</p>
        <a href={lang === 'en' ? '/en/' : '/'} class="ds-btn ds-btn--primary">{ui.reservation?.backHome || 'Retour a l\'accueil'}</a>
      </div>
    </form>
  </div>
</section>

<script>
  import { getSlotsForDate } from '../utils/reservation';
  import { isValidEmail, isValidPhoneFr, submitForm } from '../utils/forms';

  const form = document.querySelector('[data-form="reservation"]') as HTMLFormElement | null;
  if (form) {
    try {
      const uiData = { ...JSON.parse((form.dataset as any).jsonForm || '{}') };
      const staticSlots = JSON.parse((form.dataset as any).slots || '[]');
      const schedule = JSON.parse((form.dataset as any).schedule || '[]');
      const closedPeriods = JSON.parse((form.dataset as any).closed || '[]');
      const action = form.getAttribute('action') || '';

      const date = form.querySelector('#r-date') as HTMLInputElement;
      const time = form.querySelector('#r-time') as HTMLSelectElement;
      const guests = form.querySelector('#r-guests') as HTMLSelectElement;
      const name = form.querySelector('#r-name') as HTMLInputElement;
      const email = form.querySelector('#r-email') as HTMLInputElement;
      const phone = form.querySelector('#r-phone') as HTMLInputElement;
      const honeypot = form.querySelector('input[name="phone_confirm"]') as HTMLInputElement;
      const errorGlobal = form.querySelector('[data-form-error]') as HTMLElement;
      const noSlot = form.querySelector('[data-no-slot]') as HTMLElement;
      const noSlotTitle = form.querySelector('[data-no-slot-title]') as HTMLElement;
      const noSlotMsg = form.querySelector('[data-no-slot-msg]') as HTMLElement;
      const retrySlot = form.querySelector('[data-retry-slot]');
      const success = form.querySelector('[data-form-success]') as HTMLElement;
      const submit = form.querySelector('[data-form-submit]') as HTMLButtonElement;
      const submitLabel = form.querySelector('[data-form-submit-label]') as HTMLElement;

      const setFieldError = (field: HTMLInputElement | HTMLSelectElement, msg: string | null) => {
        const err = document.getElementById(`${field.id}-error`);
        if (msg) {
          field.setAttribute('aria-invalid', 'true');
          field.classList.add('ds-form__input--invalid');
          if (err) { err.textContent = msg; err.hidden = false; }
        } else {
          field.removeAttribute('aria-invalid');
          field.classList.remove('ds-form__input--invalid');
          if (err) { err.hidden = true; }
        }
      };

      // Date minimale calculee cote client (heure locale) : jamais fige au build.
      date.min = (() => {
        const d = new Date();
        return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
      })();

      const refreshSlots = () => {
        const cfg = { schedule, closedPeriods, slots: staticSlots };
        const result = date.value ? getSlotsForDate(date.value, cfg) : { slots: staticSlots, closed: false, reason: null };

        // Reinsere les options (hors placeholder)
        time.innerHTML = '';
        const placeholder = document.createElement('option');
        placeholder.value = '';
        placeholder.textContent = uiData.timeError || 'Veuillez choisir un creneau';
        time.appendChild(placeholder);

        if (result.closed) {
          // Jour ferme / aucun creneau : etat dedie (UX.md §4.3)
          time.disabled = true;
          noSlotTitle.textContent = uiData.noSlot?.title || 'Aucun creneau disponible';
          noSlotMsg.textContent = uiData.noSlot?.message || '';
          noSlot.hidden = false;
        } else {
          for (const slot of result.slots) {
            const opt = document.createElement('option');
            opt.value = slot;
            opt.textContent = slot;
            time.appendChild(opt);
          }
          time.disabled = result.slots.length === 0;
          noSlot.hidden = true;
        }
      };

      date.addEventListener('change', refreshSlots);
      retrySlot?.addEventListener('click', () => {
        noSlot.hidden = true;
        date.value = '';
        time.disabled = false;
        refreshSlots();
      });

      form.addEventListener('submit', async (ev) => {
        ev.preventDefault();
        errorGlobal!.hidden = true;

        // Honeypot : abandon silencieux
        if (honeypot && honeypot.value.trim().length > 0) return;

        // Validation des champs (utils/forms.js)
        let count = 0;
        let firstInvalid: HTMLInputElement | HTMLSelectElement | null = null;
        const mark = (field: HTMLInputElement | HTMLSelectElement, ok: boolean, msg: string) => {
          setFieldError(field, ok ? null : msg);
          if (!ok) {
            count++;
            if (!firstInvalid) firstInvalid = field;
          }
        };
        const dateOk = !!date.value;
        mark(date, dateOk, uiData.dateError || 'Veuillez choisir une date.');

        const { slots: daySlots } = date.value
          ? getSlotsForDate(date.value, { schedule, closedPeriods, slots: staticSlots })
          : { slots: [] };
        const timeOk = !!time.value && daySlots.includes(time.value);
        mark(time, timeOk, uiData.timeError || 'Veuillez choisir un creneau.');

        const guestsOk = !!guests.value;
        mark(guests, guestsOk, uiData.partySizeError || 'Veuillez indiquer le nombre de personnes.');

        const nameOk = name.value.trim().length >= 2;
        mark(name, nameOk, uiData.nameError || 'Nom obligatoire');

        const emailOk = isValidEmail(email.value);
        mark(email, emailOk, uiData.emailError || 'Email invalide');

        const phoneOk = !phone.value || isValidPhoneFr(phone.value);
        mark(phone, phoneOk, uiData.phoneError || 'Telephone invalide');

        if (count > 0) {
          errorGlobal!.textContent = (uiData.globalError || '').replace('{n}', String(count));
          errorGlobal!.hidden = false;
          firstInvalid?.focus();
          return;
        }

        submit!.disabled = true;
        submitLabel!.textContent = uiData.sending || 'Envoi...';

        try {
          await submitForm({
            endpoint: action,
            email: uiData.emailAddress || '',
            data: {
              subject: `Reservation ${uiData.siteName || ''} — ${date.value} ${time.value} (${guests.value} pers.)`,
              body: `Date: ${date.value}\nHeure: ${time.value}\nPersonnes: ${guests.value}\nNom: ${name.value}\nEmail: ${email.value}\nTelephone: ${phone.value || '—'}\n\n${(form.querySelector('#r-message') as HTMLTextAreaElement)?.value || ''}`,
            },
            formData: new FormData(form),
          });
          form.reset();
          refreshSlots();
          success!.hidden = false;
        } catch {
          errorGlobal!.textContent = uiData.loadError || "Erreur lors de l'envoi";
          errorGlobal!.hidden = false;
        }
        submit!.disabled = false;
        submitLabel!.textContent = uiData.submit || 'Envoyer';
      });
    } catch (e) {
      console.error('ReservationForm init error:', e);
    }
  }
</script>

<style>
  /*
    Base form styles now in src/styles/utilities.css (DA §5.7).
    Only ReservationForm-specific overrides remain here.
  */
  /* Mode carte : pas de padding section superieur (la page fournit le rythme) */
  .ds-section--has-card {
    padding-block: var(--space-8);
  }
  @media (min-width: 1024px) {
    .ds-section--has-card { padding-block: var(--space-8); }
  }

  .ds-form__empty,
  .ds-form__success {
    text-align: center;
    padding: var(--space-8) 0;
  }
  .ds-form__empty[hidden],
  .ds-form__success[hidden] { display: none; }

  .ds-form__empty-title,
  .ds-form__success-title {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    font-weight: 500;
    color: var(--color-ink);
    margin: var(--space-4) 0 var(--space-2);
  }
  .ds-form__empty-msg,
  .ds-form__success-msg,
  .ds-form__success-modify {
    color: var(--color-ink-soft);
    margin: 0 0 var(--space-2);
    font-size: var(--text-base);
  }
  .ds-form__empty-actions,
  .ds-form__success > .ds-btn {
    margin-top: var(--space-4);
  }
  .ds-form__empty-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    justify-content: center;
  }
</style>