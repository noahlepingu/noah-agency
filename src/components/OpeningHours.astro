---
/**
 * OpeningHours.astro — Horaires (DESIGN_SYSTEM_SPECS.md §5.12, UX.md §4.12)
 * Badge "Ouvert"/"Ferme" et mise en evidence du jour courant determines
 * COTE CLIENT (heure locale du visiteur). Sans JS : liste simple, sans badge.
 */
import { DAY_ORDER_FR } from '@utils/days.mjs';

interface Props {
  data: any; // data.components.opening_hours { schedule: [{day, open, close, closed}], title, show_status }
  ui: any;
}

const { data, ui } = Astro.props;
const schedule = data.schedule || [];
const scheduleJson = JSON.stringify(schedule);
const showStatus = data.show_status !== false;
---

<section class="ds-opening">
  <div class="ds-section-head">
    <h2 class="ds-section-head__title">{data.title || ui.hours.title}</h2>
  </div>

  {showStatus ? (
    <div
      id="ds-status"
      class="ds-opening__status"
      role="status"
      aria-live="polite"
      data-status
      data-schedule={scheduleJson}
      data-ui-open={ui.hours.open || 'Ouvert'}
      data-ui-closed={ui.hours.closed || 'Ferme'}
    ></div>
  ) : null}

  <ul class="ds-opening__list">
    {DAY_ORDER_FR.map((day) => {
      const entry = schedule.find((s: any) => s.day === day);
      const closed = !entry || entry.closed === true;
      const label = closed
        ? (ui.hours.closed || 'Ferme')
        : (entry.open && entry.close ? `${entry.open} – ${entry.close}` : '');
      return (
        <li class="ds-opening__row" data-day={day}>
          <span class="ds-opening__day">
            {day}
            <span class="ds-opening__today" data-today-mark hidden>{ui.hours.today || '(aujourd\'hui)'}</span>
          </span>
          <span class:list={['ds-opening__hours', { 'ds-opening__hours--closed': closed }]}>{label}</span>
        </li>
      );
    })}
  </ul>
</section>

<script>
  // Statut temps reel (heure locale) + jour courant — cote client uniquement.
  import { DAY_NAMES, DAY_ORDER_FR } from '../utils/days.mjs';

  const statusEl = document.querySelector('[data-status]') as HTMLElement | null;
  const rows = Array.from(document.querySelectorAll('[data-day]')) as HTMLElement[];

  const now = new Date();
  const todayName = DAY_NAMES[now.getDay()];

  // 1. Jour courant en evidence
  rows.forEach((row) => {
    if (row.dataset.day === todayName) {
      row.classList.add('ds-opening__row--today');
      const mark = row.querySelector('[data-today-mark]');
      if (mark) mark.hidden = false;
    }
  });

  // 2. Badge Ouvert/Ferme
  if (statusEl) {
    let schedule: any[] = [];
    try { schedule = JSON.parse(statusEl.getAttribute('data-schedule') || '[]'); } catch { schedule = []; }
    const entries = schedule.filter((s) => s && s.day === todayName && !s.closed);
    const minutes = now.getHours() * 60 + now.getMinutes();
    let isOpen = false;
    for (const e of entries) {
      if (e && e.open && e.close) {
        const [oh, om] = String(e.open).split(':').map(Number);
        const [ch, cm] = String(e.close).split(':').map(Number);
        const o = (oh || 0) * 60 + (om || 0);
        const c = (ch || 0) * 60 + (cm || 0);
        if (minutes >= o && minutes < c) { isOpen = true; break; }
      }
    }
    const openLabel = (statusEl.dataset.uiOpen as string) || 'Ouvert';
    const closedLabel = (statusEl.dataset.uiClosed as string) || 'Ferme';
    statusEl.innerHTML = isOpen
      ? `<strong class="ds-opening__open">${openLabel}</strong>`
      : `<span class="ds-opening__closed">${closedLabel}</span>`;
  }
</script>

<style>
  .ds-opening__list { list-style: none; margin: 0; padding: 0; max-width: 28rem; }
  .ds-opening__row {
    display: flex; justify-content: space-between; gap: var(--space-4);
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--color-gray-100);
  }
  .ds-opening__row--today { font-weight: 700; color: var(--color-gray-900); }
  .ds-opening__day { font-weight: 500; }
  .ds-opening__today { font-weight: 400; color: var(--color-gray-500); font-size: var(--text-sm); }
  .ds-opening__hours--closed { color: var(--color-gray-500); }
  .ds-opening__status { margin-bottom: var(--space-3); font-weight: 600; }
  .ds-opening__open { color: var(--color-success-dark); }
  .ds-opening__closed { color: var(--color-gray-500); }
</style>