---
/**
 * MenuCard.astro → Section typographique d'une categorie (DA §5.3)
 * Sans ds-card. Presentation : nom + ligne pointillee + prix + description.
 * Indicateurs (v)/(p)/(bio) en italique accent-dark (§8.17).
 */
interface Props {
  category: string;
  items: any[];
}

const { category, items } = Astro.props;

const tagLabel = (t: string) => {
  const map: Record<string, string> = { v: 'V', p: 'P', bio: 'Bio', 'spicy': 'P' };
  return map[t] || t;
};
---

<div class="ds-menucat">
  <h3 class="ds-menucat__category">{category}</h3>
  <ul class="ds-menucat__list">
    {items.map((item: any) => (
      <li class="ds-menucat__item">
        <div class="ds-menucat__row">
          <div class="ds-menucat__name-group">
            <span class="ds-menucat__name">{item.name}</span>
            {item.tags?.length ? (
              <span class="ds-menucat__tags" aria-label={`Tags: ${item.tags.join(', ')}`}>
                {item.tags.map((t: string) => (
                  <span class="ds-menucat__tag">{`(${tagLabel(t)})`}</span>
                ))}
              </span>
            ) : null}
          </div>
          {item.price !== undefined && item.price !== null ? (
            <span class="ds-menucat__price">&euro;{item.price}</span>
          ) : null}
        </div>
        {item.description ? <p class="ds-menucat__desc">{item.description}</p> : null}
      </li>
    ))}
  </ul>
</div>

<style>
  /* Catégorie : séparée par --space-28 entre catégories (DA §5.3) */
  .ds-menucat { margin-bottom: var(--space-28); }
  .ds-menucat:last-child { margin-bottom: 0; }

  /* Surtitre : Inter 600, 12px, uppercase, letter-spacing 0.14em, accent-dark */
  .ds-menucat__category {
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-accent-dark);
    margin: 0 0 var(--space-6);
  }

  .ds-menucat__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* Item : nom -- ligne pointillee -- prix */
  .ds-menucat__item {
    padding: var(--space-3) 0;
    border-bottom: 2px dotted var(--color-line-strong);
  }
  .ds-menucat__item:last-child { border-bottom: none; }

  .ds-menucat__row {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: baseline;
    gap: var(--space-2);
  }

  .ds-menucat__name-group {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    min-width: 0;
    overflow: hidden;
  }

  /* Nom : Fraunces 500, 26px */
  .ds-menucat__name {
    font-family: var(--font-heading);
    font-size: 1.625rem; /* 26px */
    font-weight: 500;
    line-height: 1.2;
    color: var(--color-ink);
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* Tags indicateurs : 12px, italic, accent-dark (DA §5.3) */
  .ds-menucat__tags {
    display: inline-flex;
    gap: 2px;
    font-size: 12px;
    font-style: italic;
    color: var(--color-accent-dark);
    flex-shrink: 0;
  }
  .ds-menucat__tag { white-space: nowrap; }

  /* Prix : Inter 600, 22px, tabular-nums, right-aligned */
  .ds-menucat__price {
    font-family: var(--font-body);
    font-size: 1.375rem; /* 22px */
    font-weight: 600;
    line-height: 1.2;
    color: var(--color-ink);
    text-align: right;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  /* Description : 14px, ink-soft, max 2 lignes */
  .ds-menucat__desc {
    margin: var(--space-1) 0 0;
    font-size: var(--text-sm); /* 14px */
    line-height: 1.5;
    color: var(--color-ink-soft);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>