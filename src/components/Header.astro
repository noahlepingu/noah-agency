---
/**
 * Header.astro — Navigation principale (DESIGN_SYSTEM_SPECS.md §5.1, SITEMAP_MASTER §6.1)
 * Desktop : logo + nav horizontale (max 6) + CTA + LanguageSwitcher
 * Mobile : logo + CTA compact + burger ; menu plein ecran (z--menu-mobile)
 * Accessibilite : bouton aria-expanded/aria-controls, lien actif aria-current
 */
import SkipLink from './SkipLink.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import Icon from './Icon.astro';

interface Props {
  lang: 'fr' | 'en';
  ui: any;
  data: any; // data.components.header
  langSwitchHref: string;
  translatedRoutes?: string[]; // routes avec version EN (data.translated_routes)
}

const { lang, ui, data, langSwitchHref, translatedRoutes = [] } = Astro.props;

const { nav: navItems } = data;
// Slugs actifs du site (pour aria-current)
const activePages: string[] = (data.active_pages || []).map((p: string) =>
  lang === 'en' ? (p === '/' ? '/en/' : `/en${p}`) : p,
);

// Ne prefixe /en que pour les routes dotees d'une version traduite,
// sinon on conserve le lien vers la page FR (pas de 404).
const localize = (href: string) => {
  if (lang !== 'en') return href;
  if (translatedRoutes.includes(href)) return href === '/' ? '/en/' : `/en${href}`;
  return href;
};

const links = navItems.map((item: any) => ({
  label: item.label,
  href: localize(item.href),
}));

const isActive = (href: string, currentPath: string) =>
  href === currentPath || (href !== '/en/' && href !== '/' && currentPath.startsWith(href));
---

<header class="ds-header" data-header>
  <a href="#contenu" class="skip-link">{ui.skipLink}</a>
  <div class="ds-header__inner">
    <a href={lang === 'en' ? '/en/' : '/'} class="ds-header__logo" aria-label={data.logo_text || 'Accueil'}>
      {data.logo_text ? <span class="ds-header__logotext">{data.logo_text}</span> : null}
    </a>

    <nav class="ds-header__nav" aria-label={ui.header.openMenu}>
      <ul class="ds-header__list">
        {links.map((link: any) => (
          <li>
            <a
              href={link.href}
              class:list={[
                'ds-header__link',
                { 'ds-header__link--active': isActive(link.href, Astro.url.pathname) },
              ]}
              aria-current={isActive(link.href, Astro.url.pathname) ? 'page' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="ds-header__actions">
      {langSwitchHref ? <LanguageSwitcher lang={lang} ui={ui} href={langSwitchHref} /> : null}
      {data.cta ? (
        <a href={localize(data.cta.href)} class="ds-btn ds-btn--primary ds-btn--sm ds-header__cta">
          {data.cta.label}
        </a>
      ) : null}
      <button
        class="ds-header__burger"
        type="button"
        aria-expanded="false"
        aria-controls="ds-menu-mobile"
        data-burger
      >
        <span class="sr-only">{ui.header.openMenu}</span>
        <Icon name="menu" size={24} />
      </button>
    </div>
  </div>

  <!-- Menu mobile -->
  <div id="ds-menu-mobile" class="ds-menu-mobile" hidden data-menu-mobile>
    <nav aria-label={ui.header.openMenu}>
      <ul class="ds-menu-mobile__list">
        {links.map((link: any) => (
          <li>
            <a href={link.href} class="ds-menu-mobile__link" data-menu-close>{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .ds-header {
    position: sticky;
    top: 0;
    z-index: var(--z-sticky);
    background-color: var(--color-white);
    box-shadow: var(--shadow-sm);
  }
  .ds-header__inner {
    max-width: var(--container);
    margin-inline: auto;
    display: flex;
    align-items: center;
    gap: var(--space-6);
    padding: var(--space-3) var(--space-4);
  }
  .ds-header__logo {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--color-primary);
    text-decoration: none;
    white-space: nowrap;
  }
  .ds-header__nav { margin-left: auto; }
  .ds-header__list { display: flex; gap: var(--space-2); list-style: none; margin: 0; padding: 0; }
  .ds-header__link {
    display: inline-block;
    padding: var(--space-2) var(--space-3);
    font-size: var(--text-base);
    font-weight: 500;
    color: var(--color-gray-700);
    text-decoration: none;
    border-radius: var(--radius-sm);
  }
  .ds-header__link:hover { color: var(--color-gray-900); background-color: var(--color-gray-100); }
  .ds-header__link--active { color: var(--color-primary); }
  .ds-header__actions { display: flex; align-items: center; gap: var(--space-3); }
  .ds-header__burger { display: none; }

  /* Mobile */
  @media (max-width: 1023px) {
    .ds-header__nav { display: none; }
    .ds-header__burger {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 44px;
      height: 44px;
      border: none;
      background: transparent;
      color: var(--color-gray-800);
      cursor: pointer;
      border-radius: var(--radius-sm);
    }
    .ds-header__burger:hover { background-color: var(--color-gray-100); }

    .ds-menu-mobile {
      position: fixed;
      inset: 0;
      z-index: var(--z-menu-mobile);
      background-color: var(--color-white);
      padding: var(--space-8) var(--space-4);
      overflow-y: auto;
    }
    .ds-menu-mobile[hidden] { display: none; }
    .ds-menu-mobile__list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--space-2); }
    .ds-menu-mobile__link {
      display: block;
      padding: var(--space-4) var(--space-3);
      font-size: var(--text-xl);
      font-weight: 600;
      color: var(--color-gray-900);
      text-decoration: none;
      border-radius: var(--radius-md);
    }
    .ds-menu-mobile__link:hover { background-color: var(--color-gray-100); }
  }

  @media (min-width: 1024px) {
    .ds-menu-mobile { display: none; }
  }
</style>

<script>
  // Menu burger mobile (+ fermeture au clic sur un lien)
  const burger = document.querySelector('[data-burger]');
  const menu = document.querySelector('[data-menu-mobile]');
  if (burger && menu) {
    const toggle = (open?: boolean) => {
      const willOpen = open ?? menu!.hasAttribute('hidden');
      if (willOpen) menu!.removeAttribute('hidden'); else menu!.setAttribute('hidden', '');
      burger!.setAttribute('aria-expanded', String(willOpen));
      burger!.innerText = willOpen ? '×' : '☰';
    };
    burger.addEventListener('click', () => toggle());
    menu.querySelectorAll('[data-menu-close]').forEach((l) => l.addEventListener('click', () => toggle(false)));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu!.hasAttribute('hidden')) toggle(false);
    });
  }
</script>