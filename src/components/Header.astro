---
/**
 * Header.astro — Navigation principale
 * (DESIGN_SYSTEM_SPECS.md §5.1, UX_REDESIGN_RESTAURANT.md §5.0)
 * Desktop : logo + nav horizontale (max 6) + CTA + LanguageSwitcher
 * Mobile : logo + CTA compact + burger ; menu plein ecran (z--menu-mobile)
 * DA 5.0 : header TRANSPARENT en etat hero (texte ink ; theme clair si hero
 * sombre), puis SOLIDE au scroll (> 40px) : surface-raised + border-bottom,
 * ombre supprimee (P2). 404/500 (aucun hero) : solide par defaut.
 * Accessibilite : bouton aria-expanded/aria-controls, lien actif aria-current.
 */
import LanguageSwitcher from './LanguageSwitcher.astro';
import Icon from './Icon.astro';
import { localizePath } from '@utils/i18n';

interface Props {
  lang: 'fr' | 'en';
  ui: any;
  data: any; // data.components.header
  langSwitchHref: string;
  translatedRoutes?: string[]; // routes avec version EN (data.translated_routes)
}

const { lang, ui, data, langSwitchHref, translatedRoutes = [] } = Astro.props;

const { nav: navItems } = data;
// Slugs actifs du site (pour aria-current)
const activePages: string[] = (data.active_pages || []).map((p: string) =>
  lang === 'en' ? (p === '/' ? '/en/' : `/en${p}`) : p,
);

// Cle ui.nav correspondant a un href de nav ('/' -> 'index', '/menu' -> 'menu')
const navKeyOf = (href: string) => (href === '/' ? 'index' : href.replace(/^\/+|\/+$/g, ''));

// Labels : en FR le label client (YAML) reste la source ; en EN on prefere
// ui.nav (traduit) pour ne pas propager le contenu FR du YAML (M5/m1).
const links = navItems.map((item: any) => ({
  label: lang === 'en' ? ui.nav?.[navKeyOf(item.href)] || item.label : item.label,
  href: localizePath(item.href, lang, translatedRoutes),
}));

const isActive = (href: string, currentPath: string) =>
  href === currentPath || (href !== '/en/' && href !== '/' && currentPath.startsWith(href));
---

<header class="ds-header" data-header>
  <a href="#contenu" class="skip-link">{ui.skipLink}</a>
  <div class="ds-header__inner">
    <a href={lang === 'en' ? '/en/' : '/'} class="ds-header__logo" aria-label={data.logo_text || ui.nav?.index || 'Accueil'}>
      {data.logo_text ? <span class="ds-header__logotext">{data.logo_text}</span> : null}
    </a>

    <nav class="ds-header__nav" aria-label={ui.header.desktopNav || 'Navigation principale'}>
      <ul class="ds-header__list">
        {links.map((link: any) => (
          <li>
            <a
              href={link.href}
              class:list={[
                'ds-header__link',
                { 'ds-header__link--active': isActive(link.href, Astro.url.pathname) },
              ]}
              aria-current={isActive(link.href, Astro.url.pathname) ? 'page' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="ds-header__actions">
      {langSwitchHref ? <LanguageSwitcher lang={lang} ui={ui} href={langSwitchHref} /> : null}
      {data.cta ? (
        <a href={localizePath(data.cta.href, lang, translatedRoutes)} class="ds-btn ds-btn--primary ds-btn--sm ds-header__cta">
          {lang === 'en' ? ui.header?.ctaLabel || data.cta.label : data.cta.label}
        </a>
      ) : null}
      <button
        class="ds-header__burger"
        type="button"
        aria-expanded="false"
        aria-controls="ds-menu-mobile"
        aria-label={ui.header.openMenu || 'Ouvrir le menu'}
        data-close-label={ui.header.closeMenu || 'Fermer le menu'}
        data-burger
      >
        <span class="sr-only" data-burger-label>{ui.header.openMenu}</span>
        <Icon name="menu" size={24} />
      </button>
    </div>
  </div>

  <!-- Menu mobile -->
  <div id="ds-menu-mobile" class="ds-menu-mobile" hidden data-menu-mobile>
    <nav aria-label={ui.header.mobileNav || 'Menu mobile'}>
      <ul class="ds-menu-mobile__list">
        {links.map((link: any) => (
          <li>
            <a href={link.href} class="ds-menu-mobile__link" data-menu-close>{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  /* --- Etat hero (haut de page) : transparent, sans ombre (DA §5.0) --- */
  .ds-header {
    position: sticky;
    top: 0;
    z-index: var(--z-sticky);
    background-color: transparent;
    box-shadow: none;
    transition: background-color 0.2s ease;
  }
  /* --- Etat scrolle (> 40px) : surface-raised + border-bottom, pas d'ombre --- */
  .ds-header--solid {
    background-color: var(--color-surface-raised);
    border-bottom: 1px solid var(--color-line);
  }

  .ds-header__inner {
    max-width: var(--container-max);
    margin-inline: auto;
    display: flex;
    align-items: center;
    gap: var(--space-6);
    padding: var(--space-3) var(--space-4);
  }
  /* Logo : Fraunces 600 24px, letter-spacing -0.01em, ink (DA §3.3) */
  .ds-header__logo {
    font-family: var(--font-heading);
    font-size: 24px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-ink);
    text-decoration: none;
    white-space: nowrap;
  }
  .ds-header__nav { margin-left: auto; }
  .ds-header__list { display: flex; gap: var(--space-2); list-style: none; margin: 0; padding: 0; }
  /* Nav : Inter 500, 15px, letter-spacing 0.01em (DA §3.3) */
  .ds-header__link {
    display: inline-block;
    padding: var(--space-2) var(--space-3);
    font-size: 15px;
    font-weight: 500;
    letter-spacing: 0.01em;
    color: var(--color-ink);
    text-decoration: none;
    border-radius: var(--radius-sm);
  }
  .ds-header__link:hover { color: var(--color-accent-dark); }
  .ds-header__link--active {
    color: var(--color-accent-dark);
    text-decoration: underline;
    text-underline-offset: 8px;
    text-decoration-thickness: 2px;
  }
  .ds-header__actions { display: flex; align-items: center; gap: var(--space-3); }
  .ds-header__burger { display: none; }

  /* --- Theme clair (hero sombre : variantes A image voilee / C surface-dark) --- */
  .ds-header--dark .ds-header__logo,
  .ds-header--dark .ds-header__link {
    color: var(--color-surface-raised);
  }
  .ds-header--dark .ds-header__link:hover,
  .ds-header--dark .ds-header__link--active {
    color: var(--color-accent-light);
  }
  .ds-header--dark .ds-header__burger { color: var(--color-surface-raised); }
  .ds-header--dark .ds-burger__icon { color: var(--color-surface-raised); }

  /* LanguageSwitcher (pill) en theme clair — via :global (composant separe) */
  .ds-header--dark :global(.ds-lang) {
    color: var(--color-surface-raised);
    border-color: var(--color-line-strong);
  }

  /* Mobile */
  @media (max-width: 1023px) {
    .ds-header__nav { display: none; }
    .ds-header__burger {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 44px;
      height: 44px;
      border: none;
      background: transparent;
      color: var(--color-ink);
      cursor: pointer;
      border-radius: var(--radius-sm);
    }
    .ds-header__burger:hover { background-color: var(--color-surface-alt); }

    .ds-menu-mobile {
      position: fixed;
      inset: 0;
      z-index: var(--z-menu-mobile);
      background-color: var(--color-surface-raised);
      padding: var(--space-8) var(--space-4);
      overflow-y: auto;
    }
    .ds-menu-mobile[hidden] { display: none; }
    .ds-menu-mobile__list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--space-2); }
    .ds-menu-mobile__link {
      display: block;
      padding: var(--space-4) var(--space-3);
      font-size: var(--text-xl);
      font-weight: 600;
      color: var(--color-ink);
      text-decoration: none;
      border-radius: var(--radius-md);
    }
    .ds-menu-mobile__link:hover { background-color: var(--color-surface-alt); }
  }

  @media (min-width: 1024px) {
    .ds-menu-mobile { display: none; }
  }
</style>

<script>
  // Menu burger mobile : aria-label/aria-expanded a jour, focus trap,
  // fermeture au clic sur un lien, Escape, retour focus au burger.
  const burger = document.querySelector('[data-burger]');
  const menu = document.querySelector('[data-menu-mobile]');
  if (burger && menu) {
    const openLabel = burger.getAttribute('aria-label') || 'Ouvrir le menu';
    const closeLabel = burger.getAttribute('data-close-label') || 'Fermer le menu';
    let lastFocused: HTMLElement | null = null;

    const toggle = (open?: boolean) => {
      const willOpen = open ?? menu!.hasAttribute('hidden');
      if (willOpen) menu!.removeAttribute('hidden'); else menu!.setAttribute('hidden', '');
      burger!.setAttribute('aria-expanded', String(willOpen));
      burger!.setAttribute('aria-label', willOpen ? closeLabel : openLabel);
      if (willOpen) {
        lastFocused = document.activeElement as HTMLElement | null;
        const first = menu!.querySelector('a[href], button:not([disabled])') as HTMLElement | null;
        if (first) first.focus();
      } else if (lastFocused) {
        lastFocused.focus();
        lastFocused = null;
      }
    };

    burger.addEventListener('click', () => toggle());
    menu.querySelectorAll('[data-menu-close]').forEach((l) => l.addEventListener('click', () => toggle(false)));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu!.hasAttribute('hidden')) toggle(false);
    });

    // Focus trap dans le menu mobile ouvert
    menu.addEventListener('keydown', (e) => {
      if (e.key !== 'Tab' || menu!.hasAttribute('hidden')) return;
      const focusables = Array.from(menu!.querySelectorAll('a[href], button:not([disabled])')) as HTMLElement[];
      if (focusables.length === 0) return;
      const first = focusables[0];
      const last = focusables[focusables.length - 1];
      if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
      else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
    });
  }

  // DA 5.0 — transparent puis solide : etat au scroll et selon la presence
  // d'un hero plein cadre. Le hero marque data-hero-full (variantes A/C
  // sombres et image) passe le header en theme clair (texte creme).
  const header = document.querySelector('[data-header]');
  if (header) {
    const heroFull = document.querySelector('[data-hero-full]') as HTMLElement | null;
    const heroDark = heroFull?.hasAttribute('data-hero-dark') ?? false;

    const update = () => {
      const scrolled = window.scrollY > 40;
      const solid = !heroFull || scrolled;
      header!.classList.toggle('ds-header--solid', solid);
      // Theme clair uniquement en etat hero NON scrolle sur un hero sombre
      header!.classList.toggle('ds-header--dark', !solid && heroDark);
    };

    update();
    window.addEventListener('scroll', update, { passive: true });
  }
</script>