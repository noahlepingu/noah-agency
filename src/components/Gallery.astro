---
/**
 * Gallery.astro — Galerie photos (DESIGN_SYSTEM_SPECS §5.6, DA §5.4)
 * Layout desktop : grille 6 colonnes asymetrique, gap 12px, SANS radius,
 * motif par groupe de 5 (4/2/2/2/6). Mobile : 2 colonnes 4:3, item 1 pleine
 * largeur. Lightbox native (dialog). Lazy loading + decoding async.
 */
import Icon from './Icon.astro';

interface Props {
  ui: any;
  data: any; // data.components.gallery { title, images: [{src, alt, caption?}] }
}

const { ui, data } = Astro.props;
const images = data.images || [];
const emptyText = data.empty_text || 'Aucune photo pour le moment.';
const gutter = 12; // DA §5.4 : gap 12px

// Motif asymetrique desktop répété tous les 5 items (DA §5.4) :
// 1: span4 16:10 | 2: span2 4:5 | 3: span2 4:3 | 4: span2 4:3 | 5: span6 21:9
const slot = (i: number) => i % 5;
---

<section class:list={['ds-section', { 'ds-section--alt': true }]}>
  <div class="ds-container">
    <div class="ds-section-head">
      <h2 class="ds-section-head__title">{data.title || 'Galerie'}</h2>
    </div>

    {images.length === 0 ? (
      <p class="ds-gallery__empty">{emptyText}</p>
    ) : (
      <ul class="ds-gallery">
        {images.map((img: any, i: number) => (
          <li class:list={['ds-gallery__item', `ds-gallery__item--${slot(i)}`]}>
            <button
              type="button"
              class="ds-gallery__btn"
              data-lightbox={i}
              aria-label={img.alt}
              aria-haspopup="dialog"
            >
              <img
                class="ds-gallery__img"
                src={img.src}
                alt={img.alt}
                loading="lazy"
                decoding="async"
                width={slot(i) === 0 ? 1200 : 800}
                height={slot(i) === 0 ? 750 : slot(i) === 1 ? 1000 : 600}
              />
              {img.caption ? <span class="ds-gallery__caption">{img.caption}</span> : null}
            </button>
          </li>
        ))}
      </ul>
    )}
  </div>
</section>

<dialog class="ds-lightbox" data-lightbox-dialog aria-label={ui.gallery?.dialogAria || 'Galerie'}>
  <button type="button" class="ds-lightbox__close" data-lightbox-close aria-label={ui.gallery?.close || 'Fermer'}>
    <Icon name="close" size={24} />
  </button>
  <figure class="ds-lightbox__figure">
    <img class="ds-lightbox__img" src="" alt="" data-lightbox-img />
    <figcaption class="ds-lightbox__caption" data-lightbox-caption></figcaption>
  </figure>
</dialog>

<script>
  const dialog = document.querySelector('[data-lightbox-dialog]') as HTMLDialogElement | null;
  const buttons = Array.from(document.querySelectorAll('[data-lightbox]')) as HTMLButtonElement[];

  if (dialog) {
    const imgEl = dialog.querySelector('[data-lightbox-img]') as HTMLImageElement;
    const capEl = dialog.querySelector('[data-lightbox-caption]') as HTMLElement;
    const closeBtn = dialog.querySelector('[data-lightbox-close]') as HTMLButtonElement;

    buttons.forEach((btn, i) => {
      btn.addEventListener('click', () => {
        const real = btn.querySelector('img') as HTMLImageElement;
        imgEl.src = real.src;
        imgEl.alt = real.alt;
        const cap = btn.querySelector('.ds-gallery__caption');
        capEl.textContent = cap ? cap.textContent : '';
        dialog.showModal();
      });
    });

    closeBtn.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') dialog.close();
    });
  }
</script>

<style>
  /* ------ Grille DA §5.4 : gap 12px, radius 0, 6 colonnes desktop ------ */
  .ds-gallery {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr); /* mobile : 2 colonnes */
    gap: 12px;
  }

  /* Mobile : 2 colonnes 4:3, item 1 pleine largeur (span 2) */
  .ds-gallery__item { margin: 0; min-width: 0; grid-column: span 1; }
  .ds-gallery__item--0 { grid-column: span 2; }

  .ds-gallery__btn {
    display: block;
    width: 100%;
    padding: 0;
    border: none;
    border-radius: 0; /* DA : radius 0 */
    overflow: hidden;
    background: var(--color-surface-alt);
    cursor: pointer;
    position: relative;
    aspect-ratio: 4 / 3;
  }
  /* Placeholder : damier alterné discret (voir checkered background) */
  .ds-gallery__btn::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      conic-gradient(
        var(--color-surface-alt) 90deg,
        var(--color-surface-raised) 90deg 180deg,
        var(--color-surface-alt) 180deg 270deg,
        var(--color-surface-raised) 270deg
      );
    background-size: 40px 40px;
    z-index: 0;
  }
  .ds-gallery__img {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ds-gallery__btn:focus-visible { outline: 3px solid var(--color-focus-ring); outline-offset: 2px; }

  .ds-gallery__caption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 2;
    padding: var(--space-2) var(--space-3);
    background-image: linear-gradient(to top, rgba(0, 0, 0, 0.7), transparent);
    color: var(--color-surface-raised);
    font-size: var(--text-sm);
    text-align: left;
  }

  .ds-gallery__empty { color: var(--color-ink-soft); }

  /* ------ Desktop ≥ 768px : 6 colonnes, motif asymétrique ------ */
  @media (min-width: 768px) {
    .ds-gallery { grid-template-columns: repeat(6, 1fr); }

    .ds-gallery__item--0 { grid-column: span 4; }
    .ds-gallery__item--1 { grid-column: span 2; }
    .ds-gallery__item--2 { grid-column: span 2; }
    .ds-gallery__item--3 { grid-column: span 2; }
    .ds-gallery__item--4 { grid-column: span 6; }

    .ds-gallery__item--0 .ds-gallery__btn { aspect-ratio: 16 / 10; }
    .ds-gallery__item--1 .ds-gallery__btn { aspect-ratio: 4 / 5; }
    .ds-gallery__item--4 .ds-gallery__btn { aspect-ratio: 21 / 9; }
  }

  /* ------ Lightbox (tokens : surface-dark, surface-dark-text) ------ */
  .ds-lightbox {
    border: none;
    border-radius: 0;
    padding: 0;
    background: var(--color-surface-dark);
    max-width: 90vw;
    max-height: 90vh;
  }
  .ds-lightbox::backdrop { background-color: rgba(0, 0, 0, 0.7); }
  .ds-lightbox__figure { margin: 0; display: flex; flex-direction: column; }
  .ds-lightbox__img { display: block; max-width: 90vw; max-height: 80vh; object-fit: contain; }
  .ds-lightbox__caption {
    color: var(--color-surface-dark-text);
    padding: var(--space-3);
    text-align: center;
    font-size: var(--text-sm);
  }
  .ds-lightbox__close {
    position: absolute;
    top: var(--space-2);
    right: var(--space-2);
    background: rgba(0, 0, 0, 0.5);
    color: var(--color-surface-raised);
    border: none;
    width: 44px;
    height: 44px;
    border-radius: 0;
    cursor: pointer;
    z-index: 1;
  }
  .ds-lightbox__close:hover { background: rgba(0, 0, 0, 0.8); }
  .ds-lightbox__close:focus-visible { outline: 3px solid var(--color-focus-ring); outline-offset: 2px; }
</style>