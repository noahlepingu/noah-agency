---
/**
 * ContactForm.astro — Formulaire de contact (DESIGN_SYSTEM_SPECS.md §5.5)
 * Etats : default, focus (outline), erreur par champ (aria-invalid + message),
 * erreur globale (role=alert), loading (spinner + disabled), success (role=status).
 * Envoi : action externe (Formspree / Web3Forms si configure, sinon mailto) —
 * la validation cote client est toujours active (utils/forms.js).
 * CNIL : mention d'information sous le formulaire (D-LEG).
 */
import CTA from './CTA.astro';

interface Props {
  ui: any;
  data: any; // data.components.contact_form
  lang: 'fr' | 'en';
}

const { ui, data, lang } = Astro.props;
const FORM_ACTION = data.action || ''; // ex: https://formspree.io/f/xxxx
const HONEYPOT = 'website';

// Messages passes au script via data-json-form (i18n, plus de texte en dur)
const uiJson = JSON.stringify({
  nameError: ui.form?.nameError || 'Veuillez renseigner votre nom.',
  emailError: ui.form?.emailError || 'Veuillez entrer un email valide.',
  messageError: ui.form?.messageError || 'Veuillez renseigner votre message.',
  globalError: ui.form?.globalError || '',
  loadError: ui.form?.loadError || "Erreur lors de l'envoi, veuillez reessayer.",
  sending: ui.form?.sending || 'Envoi...',
  submit: ui.form?.submit || 'Envoyer',
  siteName: data.site_name || '',
  emailAddress: data.email || '',
});
---

<form
  class="ds-form"
  method="post"
  action={FORM_ACTION}
  data-form="contact"
  data-json-form={uiJson}
  aria-describedby="form-contact-note"
  novalidate
>
  <div class="ds-form__grid">
    <div class="ds-form__field">
      <label for="cf-name" class="ds-form__label">{ui.form.name} <span aria-hidden="true">*</span></label>
      <input
        type="text"
        id="cf-name"
        name="name"
        class="ds-form__input"
        required
        autocomplete="name"
        aria-required="true"
        aria-describedby="cf-name-error"
      />
      <p class="ds-form__error" id="cf-name-error" hidden></p>
    </div>

    <div class="ds-form__field">
      <label for="cf-email" class="ds-form__label">{ui.form.email} <span aria-hidden="true">*</span></label>
      <input
        type="email"
        id="cf-email"
        name="email"
        class="ds-form__input"
        required
        autocomplete="email"
        aria-required="true"
        aria-describedby="cf-email-error"
      />
      <p class="ds-form__error" id="cf-email-error" hidden></p>
    </div>

    <div class="ds-form__field ds-form__field--full">
      <label for="cf-message" class="ds-form__label">{ui.form.message} <span aria-hidden="true">*</span></label>
      <textarea
        id="cf-message"
        name="message"
        class="ds-form__textarea"
        rows="5"
        required
        aria-required="true"
        aria-describedby="cf-message-error"
      ></textarea>
      <p class="ds-form__error" id="cf-message-error" hidden></p>
    </div>

    <!-- Honeypot anti-spam : invisible aux humains -->
    <div class="ds-form__honeypot" aria-hidden="true">
      <label for={HONEYPOT}>{ui.form.honeypot}</label>
      <input type="text" id={HONEYPOT} name={HONEYPOT} tabindex="-1" autocomplete="off" />
    </div>
  </div>

  <p class="ds-form__global-error" role="alert" hidden data-form-error></p>

  <div class="ds-form__submit-row">
    <button type="submit" class="ds-btn ds-btn--primary" data-form-submit>
      <span data-form-submit-label>{ui.form.submit}</span>
    </button>
  </div>

  <p class="ds-form__note" id="form-contact-note">{ui.form.privacyNote}</p>

  <!-- Confirmation -->
  <p class="ds-form__success" role="status" hidden data-form-success>
    <strong>{ui.form.successTitle}</strong><br />
    {ui.form.successText}
  </p>
</form>

<script>
  import { isValidEmail, submitForm } from '../utils/forms';

  const form = document.querySelector('[data-form="contact"]') as HTMLFormElement | null;
  if (form) {
    const uiData = { ...JSON.parse((form.dataset as any).jsonForm || '{}') };

    const name = form.querySelector('#cf-name') as HTMLInputElement;
    const email = form.querySelector('#cf-email') as HTMLInputElement;
    const message = form.querySelector('#cf-message') as HTMLTextAreaElement;
    const honeypot = form.querySelector('input[name="website"]') as HTMLInputElement;
    const errorGlobal = form.querySelector('[data-form-error]') as HTMLElement;
    const success = form.querySelector('[data-form-success]') as HTMLElement;
    const submit = form.querySelector('[data-form-submit]') as HTMLButtonElement;
    const submitLabel = form.querySelector('[data-form-submit-label]') as HTMLElement;
    const action = form.getAttribute('action') || '';

    const setFieldError = (field: HTMLInputElement | HTMLTextAreaElement, msg: string | null) => {
      const err = document.getElementById(`${field.id}-error`);
      if (msg) {
        field.setAttribute('aria-invalid', 'true');
        field.classList.add('ds-form__input--invalid');
        if (err) { err.textContent = msg; err.hidden = false; }
      } else {
        field.removeAttribute('aria-invalid');
        field.classList.remove('ds-form__input--invalid');
        if (err) { err.hidden = true; }
      }
    };

    const validate = () => {
      let count = 0;
      let firstInvalid: HTMLInputElement | HTMLTextAreaElement | null = null;
      const mark = (field: HTMLInputElement | HTMLTextAreaElement, ok: boolean, msg: string) => {
        setFieldError(field, ok ? null : msg);
        if (!ok) {
          count++;
          if (!firstInvalid) firstInvalid = field;
        }
      };
      // Nom
      mark(name, name.value.trim().length >= 2, uiData.nameError || 'Nom obligatoire');
      // Email (regex partagee utils/forms.js)
      mark(email, isValidEmail(email.value), uiData.emailError || 'Email invalide');
      // Message
      mark(message, message.value.trim().length > 0, uiData.messageError || 'Message obligatoire');
      if (count > 0 && errorGlobal) {
        errorGlobal.textContent = (uiData.globalError || '').replace('{n}', String(count));
        errorGlobal.hidden = false;
        firstInvalid?.focus();
      } else if (errorGlobal) { errorGlobal.hidden = true; }
      return count === 0;
    };

    // Re-validate a la saisie
    [name, email, message].forEach((f) => f.addEventListener('input', () => {
      if (f.hasAttribute('aria-invalid')) setFieldError(f, null);
    }));

    form.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      errorGlobal!.hidden = true;

      // Honeypot : abandon silencieux
      if (honeypot && honeypot.value.trim().length > 0) return;

      if (!validate()) return;

      submit!.disabled = true;
      submitLabel!.textContent = uiData.sending || 'Envoi...';

      try {
        await submitForm({
          endpoint: action,
          email: uiData.emailAddress || '',
          data: {
            subject: `Contact ${uiData.siteName || ''}`,
            body: `Nom: ${name.value}\nEmail: ${email.value}\n\n${message.value}`,
          },
          formData: new FormData(form),
        });
        form.reset();
        success!.hidden = false;
        submit!.disabled = false;
        submitLabel!.textContent = uiData.submit || 'Envoyer';
      } catch {
        submit!.disabled = false;
        submitLabel!.textContent = uiData.submit || 'Envoyer';
        errorGlobal!.textContent = uiData.loadError || 'Erreur lors de l\'envoi';
        errorGlobal!.hidden = false;
      }
    });
  }
</script>

<!-- Form base styles: src/styles/utilities.css (DA §5.7) -->
