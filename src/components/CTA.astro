---
/**
 * CTA.astro — Bouton / lien d'action (DESIGN_SYSTEM_SPECS.md §5.4)
 * Variantes : primary | secondary | outline | ghost
 * Tailles : sm | md | lg
 * Etats : default, hover, focus, disabled, loading
 */
import Icon from './Icon.astro';

interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'outline' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  icon?: string;
  fullWidth?: boolean;
  disabled?: boolean;
  loading?: boolean;
  ariaLabel?: string;
  class?: string;
  children?: any;
  external?: boolean;
  target?: string;
  type?: 'button' | 'submit';
}

const {
  href,
  variant = 'primary',
  size = 'md',
  icon,
  fullWidth = false,
  disabled = false,
  loading = false,
  ariaLabel,
  class: className = '',
  external = false,
  target,
  type = 'button',
} = Astro.props;

const classes = ['ds-btn', `ds-btn--${variant}`, `ds-btn--${size}`, fullWidth ? 'ds-btn--block' : '', className]
  .filter(Boolean)
  .join(' ');

const Tag = href ? 'a' : 'button';

const attrs = href
  ? {
      href,
      // m9 : target="_blank" implique toujours rel="noopener noreferrer"
      ...(external || target ? { target: target || '_blank', rel: 'noopener noreferrer' } : {}),
      'aria-label': ariaLabel,
      'aria-disabled': disabled || undefined,
    }
  : {
      type,
      disabled,
      'aria-label': ariaLabel,
    };
---

<Tag { ...attrs } class={classes}>
  {loading ? <span class="ds-btn__spinner" aria-hidden="true" /> : null}
  {icon && !loading ? <Icon name={icon} size={size === 'lg' ? 20 : 18} /> : null}
  <slot />
</Tag>

<style>
  .ds-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    font-family: var(--font-body);
    font-weight: 600;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
    border-radius: var(--radius-md);
    border: 2px solid transparent;
    cursor: pointer;
    transition:
      background-color var(--transition-fast),
      box-shadow var(--transition-fast),
      transform var(--transition-fast);
    min-height: 44px; /* zones tactiles >= 44px (UX.md §3.1) */
  }

  .ds-btn--sm { padding: var(--space-2) var(--space-4); font-size: var(--text-sm); }
  .ds-btn--md { padding: var(--space-3) var(--space-5); font-size: var(--text-base); }
  .ds-btn--lg { padding: var(--space-4) var(--space-6); font-size: var(--text-lg); }

  .ds-btn--primary {
    background-color: var(--color-accent);
    color: var(--color-on-accent);
  }
  .ds-btn--primary:hover { background-color: var(--color-accent-dark); box-shadow: var(--shadow-md); }
  .ds-btn--primary:active { background-color: var(--color-accent-dark); transform: translateY(1px); }

  .ds-btn--secondary {
    background-color: var(--color-primary);
    color: var(--color-on-primary);
  }
  .ds-btn--secondary:hover { background-color: var(--color-primary-dark); box-shadow: var(--shadow-md); }

  .ds-btn--outline {
    border-color: var(--color-primary);
    color: var(--color-primary);
    background-color: transparent;
  }
  .ds-btn--outline:hover { background-color: var(--color-primary-light); }

  .ds-btn--ghost {
    color: var(--color-gray-700);
    background: transparent;
  }
  .ds-btn--ghost:hover { background-color: var(--color-gray-100); color: var(--color-gray-900); }

  .ds-btn:disabled,
  .ds-btn[aria-disabled='true'] {
    background-color: var(--color-gray-300);
    color: var(--color-gray-500);
    cursor: not-allowed;
    box-shadow: none;
    border-color: var(--color-gray-300);
  }

  .ds-btn--full { width: 100%; }

  .ds-btn__spinner {
    width: 16px;
    height: 16px;
    border: 2px solid currentColor;
    border-top-color: transparent;
    border-radius: 50%;
    animation: ds-spin 0.6s linear infinite;
  }

  @keyframes ds-spin { to { transform: rotate(360deg); } }

  @media (prefers-reduced-motion: reduce) {
    .ds-btn__spinner { animation-duration: 1.2s; }
    .ds-btn { transition: none; }
  }
</style>