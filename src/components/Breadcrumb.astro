---
/**
 * Breadcrumb.astro — Fil d'Ariane (SITEMAP_MASTER §6.3, SEO §3.7)
 * Present toutes les pages sauf l'accueil.
 * Accessibilite : nav aria-label="Fil d'Ariane", ol, aria-current sur la page courante.
 * Donnees structurees BreadcrumbList injectees par le layout (schema.js).
 */
interface Props {
  items: { label: string; href: string }[];
  lang?: 'fr' | 'en';
  ui?: any;
}

const { items = [], lang = 'fr', ui = {} } = Astro.props;
const prefix = lang === 'en' ? '/en' : '';
---

<nav class="ds-breadcrumb" aria-label={ui.breadcrumb?.ariaLabel || "Fil d'Ariane"}>
  <ol class="ds-breadcrumb__list">
    {items.map((item, i) => {
      const isLast = i === items.length - 1;
      return (
        <li class="ds-breadcrumb__item">
          {isLast ? (
            <span class="ds-breadcrumb__current" aria-current="page">{item.label}</span>
          ) : (
            <a href={prefix + item.href} class="ds-breadcrumb__link">{item.label}</a>
          )}
          {!isLast ? <span class="ds-breadcrumb__sep" aria-hidden="true">/</span> : null}
        </li>
      );
    })}
  </ol>
</nav>

<style>
  .ds-breadcrumb { margin-bottom: var(--space-6); }
  .ds-breadcrumb__list { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0 var(--space-2); }
  .ds-breadcrumb__item { display: inline-flex; align-items: center; gap: var(--space-2); }
  .ds-breadcrumb__link {
    color: var(--color-ink-soft); text-decoration: none; font-size: var(--text-sm);
    transition: color var(--transition-fast);
  }
  .ds-breadcrumb__link:hover { color: var(--color-accent-dark); text-decoration: underline; }
  .ds-breadcrumb__sep { color: var(--color-line); font-size: var(--text-sm); }
  .ds-breadcrumb__current { color: var(--color-ink); font-size: var(--text-sm); font-weight: 500; }
</style>